{
  "name": "geo-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev:web": "next dev -p 3000 --hostname 127.0.0.1",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "build:web": "next build",
    "start:web": "next start",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "scan:mojibake": "node scripts/scan-mojibake.mjs",
    "dist": "npm run dist:app",
    "dist:app": "electron-builder --win dir --config.electronDist=node_modules/electron/dist --config.win.signAndEditExecutable=false",
    "dist:installer": "npm run dist"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.511.0",
    "next": "14.2.30",
    "pdf-parse": "^2.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.geo.desktop",
    "productName": "GEO桌面版",
    "files": [
      ".env.production",
      ".next/**/*",
      "public/**/*",
      "electron/**/*",
      "src/**/*",
      "package.json",
      "next.config.mjs",
      "tailwind.config.ts",
      "postcss.config.js"
    ],
    "extraResources": [
      {
        "from": "scripts/browser-extension/platform-login-helper-videohao-sync",
        "to": "browser-extension/platform-login-helper-videohao-sync"
      }
    ],
    "win": {
      "icon": "electron/assets/ai-search.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
