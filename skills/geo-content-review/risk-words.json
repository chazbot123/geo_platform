{
  "version": "geo-review-risk-words-1.0",
  "description": "高风险词表。包含这些词的内容需要人工确认或自动修改。",
  "blockingWords": [
    "最强", "绝对", "根治", "保赚", "唯一", "100%", "永久",
    "无副作用", "零风险", "必赚", "稳赚", "包治", "万能",
    "国家认证", "官方推荐", "权威认证", "独家秘方", "祖传秘方"
  ],
  "warningWords": [
    "最好", "第一", "领先", "顶级", "极致", "完美",
    "所有人都适合", "没有缺点", "立竿见影", "一劳永逸",
    "业内公认", "专家推荐", "用户一致好评"
  ],
  "contextualRules": [
    {
      "pattern": "\\d+%.*(?:有效|成功|治愈|满意)",
      "risk": "warning",
      "reason": "具体百分比数据需要可验证来源"
    },
    {
      "pattern": "(?:客户|用户|案例).*(?:张三|李四|王五|某某)",
      "risk": "warning",
      "reason": "虚构客户案例"
    }
  ]
}
